from googleapiclient.http import MediaFileUpload
from .config import FOLDER_ID_TESIS

def subir_archivo(service, ruta_local, nombre_drive=None, folder_id=FOLDER_ID_TESIS):
    if nombre_drive is None:
        nombre_drive = ruta_local.split("/")[-1]

    metadata = {
        "name": nombre_drive,
        "parents": [folder_id]
    }

    media = MediaFileUpload(ruta_local, resumable=True)

    file = service.files().create(
        body=metadata,
        media_body=media,
        fields="id"
    ).execute()

    return file.get("id")
